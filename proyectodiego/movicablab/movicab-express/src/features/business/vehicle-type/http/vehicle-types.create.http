### Ejecuta authLogin una vez en este archivo para obtener un token sin copiarlo.
@accessToken = {{authLogin.response.body.$.access_token}}

# @name authLogin
POST {{apiUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "{{authUsername}}",
  "password": "{{authPassword}}"
}

### Crear tipo de vehiculo
POST http://localhost:4000/api/tipos-vehiculo HTTP/1.1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "SUV",
  "description": "Sport Utility Vehicle",
  "status": "active"
}
