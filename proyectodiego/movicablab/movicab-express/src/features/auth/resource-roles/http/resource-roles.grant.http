@baseUrl = http://localhost:4000
@accessToken = {{authLogin.response.body.$.access_token}}

### 1. Ejecuta este login y confirma que responda 200
# Selecciona el entorno admin antes de enviarlo.
# @name authLogin
POST {{apiUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "{{authUsername}}",
  "password": "{{authPassword}}"
}

### 2. Conceder GET /api/empresas (recurso 15) al rol AUDITOR (ID 3)
# Envía esta solicitud manualmente después de authLogin.
# @name grantAuditorEmpresas
POST {{baseUrl}}/api/concesiones-rol
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "role_id": 3,
  "resource_id": 17
}

### 3. Verificar las concesiones activas del rol AUDITOR
GET {{baseUrl}}/api/concesiones-rol?role_id=3
Authorization: Bearer {{accessToken}}
